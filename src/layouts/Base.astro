---
import { Font } from 'astro:assets';
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { company } from '~/data/company';
import { stripBase, withBase } from '~/lib/url';

interface Props {
  title: string;
  description: string;
  /** Page-level surface: the board is green by default, reading pages are white mask. */
  surface?: 'board' | 'paper';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, surface = 'board', noindex = false, jsonLd = [] } = Astro.props;
// Routes are compared and canonicalised without the deployment base, so a preview on a
// sub-path points search engines at the production address.
const path = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const canonical = new URL(stripBase(Astro.url.pathname), company.url).href;
// Anything served from another origin (a github.io preview) stays out of search results.
const isProduction = Astro.site?.origin === new URL(company.url).origin;
const hidden = noindex || !isProduction;
const fullTitle = path === '/' ? title : `${title} | ${company.name}`;
const ogImage = new URL('/og.png', company.url).href;

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  alternateName: company.short,
  url: company.url,
  logo: new URL('/favicon-512.png', company.url).href,
  slogan: company.tagline,
  description: company.description,
  email: company.email,
  telephone: company.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: company.address.locality,
    addressRegion: company.address.region,
    postalCode: company.address.postalCode,
    addressCountry: company.address.country,
  },
  sameAs: company.social.map((item) => item.href),
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a2a1e" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hidden && <meta name="robots" content="noindex" />}

    <link rel="icon" href={withBase('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-sans" preload={[{ subset: 'latin', weight: '100 900', style: 'normal' }]} />
    <Font cssVariable="--font-mono" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
    {jsonLd.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
  </head>
  <body data-surface={surface}>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main" class:list={[surface === 'paper' && 'paper']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
