---
import type { Spec } from '~/data/products';

interface Props {
  specs: readonly Spec[];
  /** Product slug. Spec rows light the hotspots of the product with this scope. */
  scope: string;
  limit?: number;
}

const { specs, scope, limit } = Astro.props;
const rows = limit ? specs.slice(0, limit) : specs;
---

<dl class="spec" data-scope={scope}>
  {
    rows.map((spec) => (
      <div class="spec__row" data-at={spec.at} tabindex={spec.at ? 0 : undefined} title={spec.at ? 'Show this part on the 3D model' : undefined}>
        <dt>{spec.label}</dt>
        <dd>{spec.value}</dd>
      </div>
    ))
  }
</dl>
